# =============================================================================
# ALL Detection Project — .gitignore
# =============================================================================

# --- Raw & processed data (can be large / patient-sensitive) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Trained model weights (large binary files) ---
experiments/weights/*
!experiments/weights/.gitkeep

# --- Kaggle API key (NEVER commit credentials) ---
kaggle.json
.kaggle/

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python

# --- Virtual environments ---
venv/
.venv/
env/
.env

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- OS & editor artefacts ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Logs & experiment outputs (keep structure, not content) ---
experiments/logs/*
experiments/figures/*
experiments/tables/*
!experiments/logs/.gitkeep
!experiments/figures/.gitkeep
!experiments/tables/.gitkeep
